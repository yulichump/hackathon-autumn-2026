    "/api/v1/recurring-payments/{payment_id}": {
      "get": {
        "tags": [
          "Recurring payments"
        ],
        "summary": "Регулярный платёж по id",
        "operationId": "get_recurring_api_v1_recurring_payments__payment_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Payment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecurringPaymentOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Recurring payments"
        ],
        "summary": "Изменение регулярного платежа",
        "description": "Можно менять название, сумму, валюту, периодичность и дату ближайшей оплаты. Изменения касаются только будущих неоплаченных периодов (срок сегодня и позже); прошлые, просроченные и оплаченные периоды не меняются. Новая дата ближайшей оплаты должна быть позже последнего сохранённого периода, иначе `409`. Прекращённый платёж сначала нужно восстановить (`409`).",
        "operationId": "update_recurring_api_v1_recurring_payments__payment_id__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Payment Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecurringPaymentUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecurringPaymentOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Recurring payments"
        ],
        "summary": "Прекращение платежа с сохранением истории",
        "operationId": "delete_recurring_api_v1_recurring_payments__payment_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Payment Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
