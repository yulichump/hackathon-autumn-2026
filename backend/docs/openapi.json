    "/api/v1/recurring-payments/{payment_id}/restore": {
      "post": {
        "tags": [
          "Recurring payments"
        ],
        "summary": "Восстановление прекращённого платежа",
        "description": "Платёж снова создаёт периоды и напоминания. Периоды, срок которых прошёл, пока платёж был прекращён, не создаются: расписание продолжается с ближайшего срока не раньше сегодняшнего дня. Для активного платежа ничего не меняет.",
        "operationId": "restore_recurring_api_v1_recurring_payments__payment_id__restore_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Payment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecurringPaymentOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
