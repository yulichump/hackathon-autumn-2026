# PostgreSQL. При запуске через docker compose значение подставляется автоматически.
DATABASE_URL=postgresql+psycopg://invoice:invoice@localhost:5432/invoice_keeper
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# true — применять миграции Alembic при старте приложения (удобно для одного экземпляра)
AUTO_MIGRATE=false

SECRET_KEY=replace-with-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

TIMEZONE=Europe/Moscow

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_PROXY=
REMIND_DAYS_BEFORE=3
REMINDER_CHECK_INTERVAL_SECONDS=60

WEBHOOK_URL=

CORS_ORIGINS=*
